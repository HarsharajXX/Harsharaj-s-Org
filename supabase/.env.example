# Local Supabase Edge Functions Secrets Template
# Usage: copy to supabase/.env.local (gitignored via .gitignore rule `.env*`)
# and run: supabase functions serve --env-file supabase/.env.local
# Production: configure via `supabase secrets set ...` (NEVER use VITE_ prefix).

RAZORPAY_KEY_ID="rzp_test_your_public_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
CRON_SECRET="your_random_cron_secret_for_expire_orders"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
