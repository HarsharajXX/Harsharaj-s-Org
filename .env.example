# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (Frontend / Public - safe for browser with Row Level Security)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# RAZORPAY CLIENT (Public key_id only — safe for frontend Razorpay Standard Checkout modal)
VITE_RAZORPAY_KEY_ID="rzp_test_your_public_key_id"

# SERVER-SIDE ONLY (Supabase Edge Functions secrets — NEVER prefix with VITE_ or commit real values)
# RAZORPAY_KEY_ID="rzp_test_your_public_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
# RAZORPAY_ROUTE_ENABLED="false"
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

